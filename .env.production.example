CLERK_JWT_AUDIENCE=firmcode-api
CLERK_BILLING_PORTAL_URL=https://accounts.example.com/billing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
