NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DRY_RUN=true

# Database Provider: 'neon' or 'insforge'
DATABASE_PROVIDER=insforge

# NeonDB (legacy, retained as fallback)
DATABASE_URL=postgresql://firmcode_owner:replace_me@ep-example.us-east-2.aws.neon.tech/firmcode?sslmode=require
DATABASE_SSL=true

# InsForge Database (alternative to Neon)
# Note: If InsForge provides a direct PostgreSQL connection string, use it here.
# Otherwise, the API will use InsForge SDK for database operations.
INSFORGE_DATABASE_URL=postgresql://insforge_user:password@db.h35yzuga.eu-central.insforge.app/postgres
INSFORGE_BASE_URL=https://h35yzuga.eu-central.insforge.app
INSFORGE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
INSFORGE_SERVICE_KEY=service_key_for_server_operations
REDIS_URL=redis://localhost:6379
REVIEW_QUEUE_NAME=review-runs

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/redirect

# Auth Provider: 'clerk' or 'insforge'
AUTH_PROVIDER=clerk

# Clerk Auth (legacy, retained as fallback)
FIRMCODE_DEFAULT_CLERK_ORGANIZATION_ID=org_3EGsxXDTl8pWEfV6da6oENrYhRr
FIRMCODE_DEFAULT_CLERK_ORGANIZATION_NAME=Firmcode AI
FIRMCODE_DEFAULT_CLERK_ORGANIZATION_ROLE=org:developer
FIRMCODE_TEST_DASHBOARD_CLERK_SESSION_TOKEN=
FIRMCODE_TEST_DASHBOARD_WORKSPACE_ID=

# InsForge Auth (alternative to Clerk)
# No additional env vars needed - uses INSFORGE_BASE_URL and INSFORGE_ANON_KEY above
# Default workspace for InsForge auth:
FIRMCODE_DEFAULT_WORKSPACE_ID=
FIRMCODE_DEFAULT_WORKSPACE_NAME=Firmcode AI

# Storage Provider: 'database' (JSONB in PostgreSQL) or 'insforge' (InsForge Storage bucket)
STORAGE_PROVIDER=database
INSFORGE_STORAGE_BUCKET=review-artifacts

GITHUB_APP_ID=replace_me
GITHUB_APP_PRIVATE_KEY=replace_me
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me

LLM_PROVIDER=replace_me
LLM_API_KEY=replace_me
LLM_REVIEW_MODEL=replace_me
LLM_SUMMARY_MODEL=replace_me

SEMGREP_CONFIGS=infra/semgrep/config.yml
SEMGREP_TIMEOUT_MS=30000
SEMGREP_SCAN_TEMP_DIR=
TREESITTER_TIMEOUT_MS=5000
TREESITTER_MAX_FILE_BYTES=500000

REVIEW_LARGE_PR_MAX_CHANGED_FILES=100
REVIEW_LARGE_PR_MAX_DIFF_BYTES=250000
REVIEW_LARGE_PR_MAX_CHANGED_LINES=3000
REVIEW_LARGE_PR_MAX_ESTIMATED_TOKENS=30000
REVIEW_LARGE_PR_MAX_FILTERED_FILES=60
REVIEW_LARGE_PR_MAX_SEMGREP_RUNTIME_MS=30000
REVIEW_LARGE_PR_MAX_FULL_CONTEXT_FILES=30
REVIEW_SUMMARY_ONLY_DIFF_BYTES=750000
REVIEW_SUMMARY_ONLY_CHANGED_LINES=10000
REVIEW_SUMMARY_ONLY_ESTIMATED_TOKENS=90000
REVIEW_CI_LOG_MAX_BYTES=20000
CODEBASE_SCAN_DEFAULT_CADENCE_HOURS=24
