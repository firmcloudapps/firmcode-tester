NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth Provider: 'clerk' or 'insforge'
AUTH_PROVIDER=clerk
NEXT_PUBLIC_AUTH_PROVIDER=clerk

# InsForge Configuration (used when AUTH_PROVIDER=insforge)
NEXT_PUBLIC_INSFORGE_BASE_URL=https://h35yzuga.eu-central.insforge.app
INSFORGE_BASE_URL=https://h35yzuga.eu-central.insforge.app

# Clerk Auth (legacy, used when AUTH_PROVIDER=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/redirect
NEXT_PUBLIC_CLERK_ORGANIZATIONS_ENABLED=false

# InsForge Auth (used when AUTH_PROVIDER=insforge)
FIRMCODE_DEFAULT_WORKSPACE_ID=
FIRMCODE_DEFAULT_WORKSPACE_NAME=Firmcode AI
INSFORGE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

GITHUB_APP_INSTALL_URL=https://github.com/apps/firmcodeai/installations/new
# Alternatively set GITHUB_APP_SLUG=firmcodeai

# Test-only fixtures for isolated web unit tests; leave unset for normal local development and production.
FIRMCODE_TEST_DASHBOARD_CLERK_SESSION_TOKEN=
FIRMCODE_TEST_DASHBOARD_WORKSPACE_ID=
