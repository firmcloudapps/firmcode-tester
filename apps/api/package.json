{
  "name": "@firmcode/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for Firmcode webhooks and dashboard endpoints.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "npm run build && node dist/infrastructure/database/run-migrations.js",
    "db:migrate:runtime": "node dist/infrastructure/database/run-migrations.js",
    "dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.13",
    "@firmcode/shared": "0.1.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "bullmq": "^5.77.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.20.0",
    "pg-mem": "^3.0.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
